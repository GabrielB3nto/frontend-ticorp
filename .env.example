# Frontend TiCorp Environment Variables
# Preencha os valores abaixo conforme necessário

# API Configuration
VITE_API_URL=/api
VITE_API_TIMEOUT=30000

# Application
VITE_APP_TITLE=TiCorp - Gerenciamento de Pontos
VITE_APP_VERSION=0.1.0

# Features (true/false)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEV_TOOLS=true
